{
  "manifest_version": 3,
  "name": "FormXpert — Smart Portal Automator",
  "version": "1.0.0",
  "description": "FormXpert Automator provides High-speed rule & profile-based form automation engine for web portals and regex support.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "FormXpert"
  },

  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },

  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "execute_autofill": {
      "suggested_key": {
        "default": "Alt+F"
      },
      "description": "Execute FormXpert on current page"
    }
  }
}